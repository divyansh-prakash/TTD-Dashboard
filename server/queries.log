{"ts":"2026-06-03T11:16:48.832Z","db":"dpttd","sql":"SELECT seg_tag, SUM(served) AS times_served, uniqMerge(cnt) AS distinct_content, SUM(total) AS total_requests FROM ( SELECT trimBoth(arrayJoin(splitByChar(',', segment))) AS seg_tag, if(success > 0, total, 0) AS served, total, uniqState(contentid) AS cnt FROM ctv_stats WHERE date >= '2026-06-02' AND date <= '2026-06-02' AND NOT startsWith(contentid, 'iris') AND segment != '' ) WHERE seg_tag != '' GROUP BY seg_tag HAVING times_served > 0 ORDER BY times_served DESC LIMIT 10"}
{"ts":"2026-06-03T11:16:48.832Z","db":"dpttd","sql":"SELECT seg_tag, SUM(served) AS times_served, uniqMerge(cnt) AS distinct_content, SUM(total) AS total_requests FROM ( SELECT trimBoth(arrayJoin(splitByChar(',', segment))) AS seg_tag, if(success > 0, total, 0) AS served, total, uniqState(contentid) AS cnt FROM ctv_stats WHERE date >= '2026-06-02' AND date <= '2026-06-02' AND NOT startsWith(contentid, 'iris') AND segment != '' ) WHERE seg_tag != '' GROUP BY seg_tag HAVING distinct_content >= 10 ORDER BY times_served ASC LIMIT 10"}

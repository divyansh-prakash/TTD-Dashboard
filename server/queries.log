{"ts":"2026-06-03T11:22:11.614Z","db":"dpttd","sql":"SELECT seg_tag, SUM(if(success > 0, total, 0)) AS times_served, uniq(contentid) AS distinct_content, SUM(total) AS total_requests FROM ( SELECT trimBoth(arrayJoin(splitByChar(',', segment))) AS seg_tag, contentid, success, total FROM ctv_stats WHERE date >= '2026-06-02' AND date <= '2026-06-02' AND NOT startsWith(contentid, 'iris') AND segment != '' ) WHERE seg_tag != '' GROUP BY seg_tag HAVING times_served > 0 ORDER BY times_served DESC LIMIT 10"}
{"ts":"2026-06-03T11:22:11.615Z","db":"dpttd","sql":"SELECT seg_tag, SUM(if(success > 0, total, 0)) AS times_served, uniq(contentid) AS distinct_content, SUM(total) AS total_requests FROM ( SELECT trimBoth(arrayJoin(splitByChar(',', segment))) AS seg_tag, contentid, success, total FROM ctv_stats WHERE date >= '2026-06-02' AND date <= '2026-06-02' AND NOT startsWith(contentid, 'iris') AND segment != '' ) WHERE seg_tag != '' GROUP BY seg_tag HAVING distinct_content >= 10 ORDER BY times_served ASC LIMIT 10"}
{"ts":"2026-06-03T11:22:11.618Z","db":"dpttd","sql":"SELECT toHour(timestamp) AS hour, SUM(total) AS req_total FROM ctv_stats WHERE success = 0 AND date >= '2026-06-02' AND date <= '2026-06-02' AND NOT startsWith(contentid, 'iris') GROUP BY hour ORDER BY hour ASC"}
{"ts":"2026-06-03T11:22:11.618Z","db":"dpttd","sql":"SELECT toHour(timestamp) AS hour, SUM(total) AS req_total FROM ctv_stats WHERE date >= '2026-06-02' AND date <= '2026-06-02' AND NOT startsWith(contentid, 'iris') GROUP BY hour ORDER BY hour ASC"}

{"ts":"2026-05-28T09:14:09.651Z","db":"dpttd","sql":"SELECT url, matchedby, SUM(total) AS req_served FROM ctv_stats WHERE success > 0 AND date >= '2026-05-27' AND date <= '2026-05-27' AND NOT startsWith(contentid, 'iris') AND url IN ('151908','b089qxrrhd','com.roku.web.trc','G18183011458','com.roku.remote','482066631','ROKU') AND matchedby != '' AND matchedby IS NOT NULL GROUP BY url, matchedby ORDER BY req_served DESC"}
{"ts":"2026-05-28T09:14:09.652Z","db":"dpttd","sql":"SELECT url, SUM(total) AS req_total, uniq(contentid) AS content_count FROM ctv_stats WHERE success = 0 AND date >= '2026-05-27' AND date <= '2026-05-27' AND NOT startsWith(contentid, 'iris') AND url IN ('151908','b089qxrrhd','com.roku.web.trc','G18183011458','com.roku.remote','482066631','ROKU') AND (matchedby = '' OR matchedby IS NULL) GROUP BY url ORDER BY req_total DESC"}
{"ts":"2026-05-28T09:14:09.654Z","db":"dpttd","sql":"SELECT contentid, url, channel, SUM(total) AS req_total, any(matchedby) AS matchedby, any(segment) AS segment, any(isbrandsafe) AS isbrandsafe FROM ctv_stats WHERE success = 0 AND date >= '2026-05-27' AND date <= '2026-05-27' AND NOT startsWith(contentid, 'iris') AND url IN ('151908','b089qxrrhd','com.roku.web.trc','G18183011458','com.roku.remote','482066631','ROKU') GROUP BY contentid, url, channel HAVING (matchedby = '' OR matchedby IS NULL) ORDER BY req_total DESC LIMIT 50 OFFSET 0"}

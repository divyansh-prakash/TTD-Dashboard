{"ts":"2026-05-28T09:46:32.773Z","db":"dpttd","sql":"SELECT contentid, url, channel, SUM(total) AS req_total, any(matchedby) AS matchedby, any(segment) AS segment, any(isbrandsafe) AS isbrandsafe FROM ctv_stats WHERE success = 0 AND date >= '2026-05-27' AND date <= '2026-05-27' AND NOT startsWith(contentid, 'iris') AND url IN ('com.sbs.ondemand.tv','542090992','com.sbs.ondemand.android','au.com.sbs.ondemand') GROUP BY contentid, url, channel HAVING (matchedby = '' OR matchedby IS NULL) ORDER BY req_total DESC LIMIT 50 OFFSET 0"}
{"ts":"2026-05-28T09:46:32.774Z","db":"dpttd","sql":"SELECT url, SUM(total) AS req_total, uniq(contentid) AS content_count FROM ctv_stats WHERE date >= '2026-05-27' AND date <= '2026-05-27' AND NOT startsWith(contentid, 'iris') AND url IN ('com.sbs.ondemand.tv','542090992','com.sbs.ondemand.android','au.com.sbs.ondemand') GROUP BY url ORDER BY req_total DESC"}
